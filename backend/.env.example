# Required — Gemini, for script generation and translation.
GOOGLE_API_KEY=

# Optional — only needed when TTS_ENGINE=elevenlabs.
ELEVEN_API_KEY=
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# TTS engine: "edge" (free, default) or "elevenlabs".
# Falls back to edge automatically on a quota error.
# TTS_ENGINE=edge
# TTS_CONCURRENCY=4
# Retries per segment, so one dropped connection doesn't waste a whole render.
# TTS_MAX_ATTEMPTS=3
# TTS_RETRY_BASE_DELAY_MS=500

# Rendered audio is a cache — the host filesystem is wiped on deploy.
# AUDIO_TTL_HOURS=6
# AUDIO_MAX_MB=512

# Runaway guard, not an abuse defence — this app runs locally. Sized so normal
# use never reaches them. Tighten these first if it is ever exposed publicly.
# RATE_LIMIT_SESSION=60/hour
# RATE_LIMIT_TRANSLATE=120/hour
# RATE_LIMIT_YOUTUBE=60/hour
# RATE_LIMIT_REMIX=240/hour
# MAX_CONCURRENT_GENERATIONS=2
# TRUSTED_PROXY_HOPS=1

# Extra CORS origins, comma-separated.
# ALLOWED_ORIGINS=

# LOG_LEVEL=INFO
# Returns raw exception text to clients. Never enable in production.
# DEBUG_ERRORS=false
