{
  "name": "בונה הכלים",
  "short_name": "בונה הכלים",
  "description": "מתארים מה רוצים לנהל ומקבלים לוח שליטה אישי מבוסס AI",
  "lang": "he",
  "dir": "rtl",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0f14",
  "theme_color": "#0b0f14",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "text/*", ".txt", ".md"] }]
    }
  },
  "shortcuts": [
    { "name": "מה אני צריך עכשיו", "url": "./#/", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "בניית כלי חדש", "url": "./#/build", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
